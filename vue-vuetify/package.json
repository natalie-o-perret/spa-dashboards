{
  "name": "dashboard-vue-vuetify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "npm run build",
    "check": "npm run format:check && npm run lint && npm run test && npm run typecheck",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "effect": "4.1.0",
    "vue": "3.5.44",
    "vuetify": "4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
